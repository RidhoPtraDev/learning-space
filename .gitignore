# ──────────────────────────────────────────────
#  LearningSpace — Root .gitignore
# ──────────────────────────────────────────────

# ── Dependencies ──────────────────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js

# ── Environment / Secrets ─────────────────────
.env
.env.local
.env.*.local
*.env

# ── Build outputs ─────────────────────────────
dist/
build/
out/

# ── Vite cache (auto-generated, never commit) ──
.vite/
**/.vite/
**/node_modules/.vite/

# ── Uploaded files (runtime, not versioned) ───
learning-space-api/uploads/foto/*
learning-space-api/uploads/kelas/*
learning-space-api/uploads/materi/*
learning-space-api/uploads/layanan/*
# Keep placeholder so folders remain in repo
!learning-space-api/uploads/foto/.gitkeep
!learning-space-api/uploads/kelas/.gitkeep
!learning-space-api/uploads/materi/.gitkeep
!learning-space-api/uploads/layanan/.gitkeep

# ── Logs ──────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS Metadata ───────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
__MACOSX/

# ── Editor / IDE ──────────────────────────────
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Testing ───────────────────────────────────
coverage/
.nyc_output/

# ── Misc ──────────────────────────────────────
*.tgz
*.zip
package-lock.json
